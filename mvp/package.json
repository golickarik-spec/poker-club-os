  "version": "0.4.0",
  "description": "Poker Club OS — interactive prototype of a B2B poker club platform (virtual chips only, no monetary value).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
